{
  "title": "PostPixTransaction",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "amount": {
      "type": "integer",
      "minimum": 0
    },
    "transaction_date": {
      "type": "string",
      "minLength": 1
    },
    "source_account": {
      "type": "object",
      "properties": {
        "branch": { "type": "string", "minLength": 1 },
        "account_number": { "type": "string", "minLength": 1 },
        "opening_date": { "type": "string", "minLength": 1 },
        "owner": {
          "type": "object",
          "properties": {
            "document_number": {
              "type": "string",
              "pattern": "^(\\d{3}\\.\\d{3}\\.\\d{3}-\\d{2}|\\d{2}\\.\\d{3}\\.\\d{3}/\\d{4}-\\d{2})$"
            }
          },
          "required": ["document_number"],
          "additionalProperties": false
        }
      },
      "required": ["branch", "account_number", "opening_date", "owner"],
      "additionalProperties": false
    },
    "destination_account": {
      "type": "object",
      "properties": {
        "participant": { "type": "string", "minLength": 1 },
        "branch": { "type": "string", "minLength": 1 },
        "account_number": { "type": "string", "minLength": 1 },
        "opening_date": { "type": "string", "minLength": 1 },
        "owner": {
          "type": "object",
          "properties": {
            "document_number": {
              "type": "string",
              "pattern": "^(\\d{3}\\.\\d{3}\\.\\d{3}-\\d{2}|\\d{2}\\.\\d{3}\\.\\d{3}/\\d{4}-\\d{2})$"
            }
          },
          "required": ["document_number"],
          "additionalProperties": false
        }
      },
      "required": ["participant", "branch", "account_number", "opening_date", "owner"],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "device_id": { "type": "string", "minLength": 1 },
        "channel": { "type": "string", "minLength": 1 },
        "ip": { "type": "string", "minLength": 1 },
        "geolocation": {
          "type": "object",
          "properties": {
            "latitude": { "type": "number" },
            "longitude": { "type": "number" }
          },
          "required": ["latitude", "longitude"],
          "additionalProperties": false
        }
      },
      "required": ["device_id", "channel", "ip"],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "amount",
    "transaction_date",
    "source_account",
    "destination_account",
    "source"
  ],
  "additionalProperties": false
}
